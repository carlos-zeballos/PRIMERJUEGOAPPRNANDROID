# Firebase — copia este archivo como .env y completa con tus valores reales
# Los obtienes en: Firebase Console → Proyecto → Configuración del proyecto → Tus apps

EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=susurros-XXXXX.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=susurros-XXXXX
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=susurros-XXXXX.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Google Sign-In (expo-auth-session) — Google Cloud Console → Credenciales
# El androidClientId debe generarse con el mismo android.package de app.json
# (com.zebware.susurros) y la huella SHA-1 del keystore usado para firmar el APK/AAB.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
